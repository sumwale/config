#!/bin/bash

#
# Script to be run by restic-restore towards the end to perform post-restore actions
# in a chroot'ed environment that are strictly machine-specific like grub bootloader
# installation, keepassxc-unlock registrations using systemd-creds, installing the
# correct nvidia driver etc.
#

set -o pipefail

# ensure that only system paths are searched for all the utilities
export PATH="/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/sbin:/usr/local/bin"
# set umask to default so that root operations create readable entities
umask 022

if [ $(id -u) -ne 0 ]; then
  echo "This script should be run as root"
  exit 1
fi

# set hostname to the one in this system's /etc/hostname
hostname --file /etc/hostname
mail_name="$(cat /etc/hostname).localdomain"
debconf-set-selections <<< "dma dma/mailname string $mail_name"

# run grub-install, update-grub again and reconfigure few other packages that create
# files unique to the system
export DEBIAN_FRONTEND=noninteractive
dpkg-reconfigure grub-efi-amd64
dpkg-reconfigure -p critical dma nvme-cli openssh-server shim-signed
echo "$mail_name" > /etc/mailname

# re-encrypt keepassxc-unlock passwords
creds_dir=/etc/credstore.encrypted
restic_login_pass=$creds_dir/restic-login
gpg_base_opts="--quiet --batch --no-tty --no-symkey-cache --pinentry-mode loopback --passphrase-fd 3"
kpxc_dir=/var/lib/restic/keys.backup/keepassxc-unlock
if systemd-analyze has-tpm2 --quiet; then
  for kpxc_key in $kpxc_dir/*/kdbx-*.gpg; do
    if [[ ! "$kpxc_key" =~ ^$kpxc_dir/([^/]+)/kdbx-([0-9a-fA-F]+)\.gpg$ ]]; then
      continue
    fi
    kpxc_name="${BASH_REMATCH[2]}"
    target_file="/etc/keepassxc-unlock/${BASH_REMATCH[1]}/kdbx-$kpxc_name.conf"
    rm -f "$target_file"
    while read -r dec_line; do
      echo "$dec_line" >> "$target_file"
      if [ "$dec_line" = "PASSWORD:" ]; then
        IFS= read -rd '' kpxc_pass
        printf '%s' "$kpxc_pass" | systemd-creds --quiet --with-key=host+tpm2 --name="$kpxc_name" encrypt - - >> "$target_file"
        break
      fi
    done < <(gpg --decrypt $gpg_base_opts 3< <(systemd-creds --quiet --name=restic-login decrypt $restic_login_pass -) -o - "$kpxc_key")
  done
fi

# check if nvidia driver is the correct one, else remove/replace with the correct one
nvidia_driver=$(ubuntu-drivers list --recommended | mawk '/^nvidia-driver/ { print $1 }')
nvidia_driver_inst=$(dpkg -l | mawk '/^ii[[:space:]]+nvidia-driver/ { print $2 }')
if [ "$nvidia_driver" != "$nvidia_driver_inst" ]; then
  if [ -n "$nvidia_driver_inst" ]; then
    nala purge "$nvidia_driver_inst" -y
  fi
  if [ -n "$nvidia_driver" ]; then
    # always prefer the dkms package and not the pre-packaged kernel-specific modules
    nvidia_dkms="${nvidia_driver/-driver-/-dkms-/}"
    nala install "$nvidia_dkms" "$nvidia_driver" nvidia-prime nvidia-settings --no-install-recommends -y
    apt-mark auto "$nvidia_dkms" nvidia-prime nvidia-settings
    systemctl mask nvidia-persistence.service
    systemctl enable nvidia-suspend.service
    systemctl enable nvidia-resume.service
  fi
elif [ -n "$nvidia_driver_inst" ]; then
  # reconfigure the dkms to regenerate the modules and possibly setup MOK registration
  nvidia_dkms="${nvidia_driver_inst/-driver-/-dkms-/}"
  dpkg-reconfigure dkms "$nvidia_dkms"
fi

# kill lingering gpg processes
gpgconf --kill all

# disable restic timers
systemctl disable restic-backup.timer
systemctl disable restic-prune.timer
