#!/bin/bash

#
# Script to sync/restore data from a remote restic backup to local directory.
# This script is meant to be run as the root user.
#
# This will update/restore the entire OS, so it should not be an active one
# rather the machine should be booted off a USB, for example, and the system to be
# upgraded will be mounted somewhere. This script will try to auto-detect the
# directories to be mounted for simpler layouts, but for more complex ones
# (like /usr, /var or parts of them also mounted elsewhere) the user will need
# to mount all the required partitions on some path.
#
# The installation can be an existing one being used or an entirely fresh one.
# The script makes no assumption of any existing data on the system apart from
# a minimal Ubuntu/Debian/openSUSE/... having basic utilities like ssh, wget
# and essential ones like awk/sed/... that are present in all usable installations.
# It makes use of restic, resticprofile, rclone which are downloaded from the latest
# bundle uploaded by the last backup process and relevant configuration files to a public
# google drive location.
#

set -o pipefail

# ensure that only system paths are searched for all the utilities
export PATH="/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/sbin:/usr/local/bin"
# set umask to default so that root operations create readable entities
umask 022

[ $(id -u) -ne 0 ] && { echo "This script should be run as root"; exit 1; }
[ "$#" -gt 1 ] && { echo "Usage: one optional argument for the target directory"; exit 1; }

fg_red='\033[31m'
fg_green='\033[32m'
fg_orange='\033[33m'
fg_cyan='\033[36m'
fg0='\033[00m'

root_mnt="$1"
tmp_mnt_prefix=/tmp/restic-sync-tmpmount-
final_mnt_prefix=/restic-sync-target-
dev_by_uuid=/dev/disk/by-uuid
restic_bundle_name=restic-bundle.tar.zst.gpg

declare -a all_mounts
declare -a bind_paths
tmp_fstab=$(mktemp /tmp/fstab.XXXXXX)

AWK=awk
command -v mawk >/dev/null 2>&1 && AWK=mawk

function mount_tmp() {
  mnt_dev="$1"
  shift
  mnt_dir="${tmp_mnt_prefix}$mnt_dev"
  mkdir -p "$mnt_dir" 2>/dev/null
  if mount "$@" "$dev_by_uuid/$mnt_dev" "$mnt_dir" 2>/dev/null; then
    printf '%s' "$mnt_dir"
  fi
}

function umount_tmp() {
  umount "$1" 2>/dev/null
  rmdir "$1"
  return 0
}

function cleanup() {
  rm -f "$restic_bundle_name" "$tmp_fstab"
  for mnt_dir in "${tmp_mnt_prefix}"*; do
    [ -d "$mnt_dir" ] && umount_tmp "$mnt_dir"
  done
  if [ -n "$root_mnt" -a -d "$root_mnt" ]; then
    for (( idx=${#bind_paths[@]}-1; idx>=0; idx-- )); do
      umount "$root_mnt${bind_paths[idx]}"
    done
    rmdir "$root_mnt" 2>/dev/null
  fi
  # unmount in reverse order
  for (( idx=${#all_mounts[@]}-1; idx>=0; idx-- )); do
    echo -e "${fg_green}Unmounting ${all_mounts[idx]}$fg0"
    for i in {1..3}; do
      umount "${all_mounts[idx]}" && break
      sleep 3
    done
  done
  rmdir $final_mnt_prefix* 2>/dev/null || /bin/true
}

trap "cleanup" EXIT

function find_btrfs_root_copy_fstab() {
  local found_root
  # temporarily mount the top-level partition to search for the root subvolume
  mnt_dir=$(mount_tmp "$1" -t btrfs -o subvolid=5)
  [ -z "$mnt_dir" ] && return 1
  readarray -t sub_volumes < <(btrfs subvolume list "$mnt_dir" | sed -n 's/^ID .* path //p')
  for d in "" "${sub_volumes[@]}"; do
    if [ -d "$mnt_dir/$d/usr" ] && [ -f "$mnt_dir/$d/etc/fstab" ]; then
      if [ -z "$found_root" ]; then
        found_root="$d"
      elif [ -z "$has_multiple_roots" ]; then
        has_multiple_roots=yes
      else
        break
      fi
    fi
  done
  ret_code=1
  if [ -n "$found_root" ]; then
    if [ -n "$has_multiple_roots" ]; then
      echo "${fg_orange}Found multiple root subvolume candidates for device $(blkid --uuid $1), "\
        "using first one in subvolume '$found_root'$fg0"
    fi
    cp "$mnt_dir/$found_root/etc/fstab" "$tmp_fstab"
    ret_code=0
  fi
  umount_tmp "$mnt_dir"
  return $ret_code
}

function find_root_copy_fstab() {
  if [ "$2" = "btrfs" ]; then
    find_btrfs_root_copy_fstab "$1"
    return $?
  fi
  mnt_dir=$(mount_tmp "$1" -t "$2")
  [ -z "$mnt_dir" ] && return 1
  ret_code=1
  if [ -d "$mnt_dir/usr" ] && [ -f "$mnt_dir/etc/fstab" ]; then
    cp "$mnt_dir/etc/fstab" "$tmp_fstab"
    ret_code=0
  fi
  umount_tmp "$mnt_dir"
  return $ret_code
}

function detect_and_mount_volumes() {
  supported_fs=" ext4 btrfs ext3 ext2 xfs jfs f2fs "
  local found_root
  while read -r fs_type uuid; do
    if [[ $supported_fs == *" $fs_type "* ]]; then
      find_root_copy_fstab "$uuid" "$fs_type" && found_root="$uuid" && break
    fi
  done < <(lsblk -n -o FSTYPE,UUID)
  if [ -n "$found_root" ]; then
    root_mnt="${final_mnt_prefix}$found_root"
    echo -e "${fg_green}Mounting devices listed in /etc/fstab copied from " \
      "device $(blkid --uuid $found_root) on $root_mnt:$fg_cyan\n"
    cat "$tmp_fstab"
    echo
    echo -en "${fg_orange}Hit <Enter> to proceed with the above setup, else hit <Ctrl-c> to abort.$fg0"
    read resp
    while read -r _ fs_dev fs_mnt fs_type fs_opts; do
      dev_resolved=$(findfs "$fs_dev" 2>/dev/null || printf '%s' "$fs_dev")
      mnt_point="$root_mnt$(printf '%b' "$fs_mnt")"  # printf resolves fstab escapes
      [ ! -d "$mnt_point" ] && mkdir -p "$mnt_point"
      echo -e "${fg_green}Mounting device $dev_resolved on $mnt_point$fg0"
      mount -t "$fs_type" -o "$fs_opts" "$dev_resolved" "$mnt_point"
      all_mounts+=("$mnt_point")
    done < <($AWK -v supported_fs="$supported_fs vfat msdos auto " '/^[^#].*/ {
        if (NF >= 4 && NF <= 6 && $2 ~ /^\// && index(supported_fs, " " $3 " ")) {
          print length($2),$1,$2,$3,$4
        }
      }' "$tmp_fstab" | sort -ns)
  else
    echo -e "${fg_red}Could not detect any root device candidate. If it is on an encrypted" \
      "device then decrypt and open the devices (e.g. using 'cryptsetup luksOpen') and run the" \
      "script again, else if on an unsupported FS like zfs or other special setup then mount" \
      "the volumes manually and run the script providing the target directory as an argument.$fg0"
    return 1
  fi
}

if [ -z "$root_mnt" ]; then
  echo "No target directory provided. Trying to auto-detect..."
  detect_and_mount_volumes
  ret_code=$?
  [ "$ret_code" -ne 0 ] && exit $ret_code
fi

creds_dir=/etc/credstore.encrypted
restic_login_pass="$creds_dir/restic-login"
restic_store_pass="$creds_dir/restic-store"
[ ! -d "$creds_dir" ] && mkdir "$creds_dir" && chmod 0700 "$creds_dir"

# ask and test the restic login/store passwords multiple times:
#   - attempt to decrypt the URL using the provided restic login password
#   - pull restic-bundle and attempt to decrypt using the provided restic store password
if systemd-analyze has-tpm2 --quiet; then
  host_key_arg="--with-key=tpm2"
fi
function ask_restic_pass() {
  pass_file="$1"
  rm -f "$pass_file"
  systemd-ask-password "Password for $2:" | tr -d '\n' | \
    systemd-creds $host_key_arg --name="$(basename "$pass_file")" encrypt - "$pass_file"
  chmod 0400 "$pass_file"
}

gpg_base_opts="--quiet --batch --no-tty --no-symkey-cache --pinentry-mode loopback --passphrase-fd 3"
restic_bundle_url_enc='-----BEGIN PGP MESSAGE-----

jA0ECQMKpFzzOY8ELt7/0osBoSQ1QJ688PszQA74a70mwjzWEBe9hOzV0tiluYNF
FnIN2q5Wqi69jcd7qx3WstoBWhuoDM4Qdk9ecGZoyOczuvdJpkjVZ42A6YQjVMOZ
w8OU9qK57Wb+fFsfNciEzeuZY0Rk1OclRq7Ww5+Pacto2KE9+sXS6NH+X8PiufqC
j3GVTEngc69be4Uz
=PR+W
-----END PGP MESSAGE-----'
for i in {1..3}; do
  ask_restic_pass "$restic_login_pass" "remote login"
  # test the password for URL decryption
  restic_bundle_url=$(printf '%s' "$restic_bundle_url_enc" | gpg --decrypt $gpg_base_opts 3< <(systemd-creds --name=restic-login decrypt "$restic_login_pass" -) -o - -)
  [ -n "$restic_bundle_url" ] && break
  echo -e "${fg_orange}Failed to decrypt gdrive URL using this password. Please try again.$fg0"
done
if [ -z "$restic_bundle_url" ]; then
  echo -e "${fg_red}Failed due to invalid remote login password.$fg0"
  exit 2
fi
rm -f "$restic_bundle_name"
wget -q --show-progress "$restic_bundle_url" -O "$restic_bundle_name"

for i in {1..3}; do
  ask_restic_pass "$restic_store_pass" "data store"
  # decrypt and untar the package
  if gpg --decrypt $gpg_base_opts 3< <(systemd-creds --name=restic-store decrypt $restic_store_pass -) -o - "$restic_bundle_name" | tar -C / --zstd -xpf -; then
    export RCLONE_CONFIG=/var/lib/restic/rclone.conf
    rm -f "$restic_bundle_name"
    break
  fi
  echo -e "${fg_orange}Failed to decrypt $restic_bundle_name using this password." \
    "Please try again.$fg0"
done
if [ -z "$RCLONE_CONFIG" -o ! -f "$RCLONE_CONFIG" ]; then
  echo -e "${fg_red}Failed due to invalid data store password.$fg0"
  exit 2
fi

# remove some known directories that have changed to symlinks in the backup that cause
# failures during restore
check_dirs=("/home/*/.config/gtk-3.0" "/home/*/.config/gtk-4.0" "/usr/share/X11/xkb")
for check_dir in "${check_dirs[@]}"; do
  resolved_dirs=$(compgen -G "$root_mnt$check_dir")
  for resolved_dir in $resolved_dirs; do
    if [ -d "$resolved_dir" ]; then
      rm -rf "$resolved_dir"
    fi
  done
done
# setup environment and start the restore
echo -e "${fg_orange}\nStarting restic restore for the entire data overwriting $root_mnt\n"
echo -en "Press <Enter> to continue...$fg0"
read -r dummy
resticprofile gdrive.restore latest --target "$root_mnt"

# chroot to the target directory and run the finish script for grub install and other
# post-restore system configurations
echo -e "${fg_green}Finishing up after the restore.\n$fg0"
bind_paths=(/dev /dev/pts /proc /run /sys /etc/resolv.conf)
if [ -d /sys/firmware/efi/efivars ]; then
  bind_paths+=(/sys/firmware/efi/efivars)
fi
if [ -d /sys/fs/selinux ]; then
  bind_paths+=(/sys/fs/selinux)
fi
for bind_path in ${bind_paths[@]}; do
  mount -o bind $bind_path "$root_mnt$bind_path"
done
if [ ! -f "$root_mnt/var/lib/systemd/credential.secret" ]; then
  chroot "$root_mnt" systemd-creds setup
fi
if chroot "$root_mnt" systemd-analyze has-tpm2 --quiet; then
  key_arg="--with-key=host+tpm2"
fi
for pass_file in "$restic_login_pass" "$restic_store_pass"; do
  rm -f "$root_mnt$pass_file"
  pass_name=$(basename "$pass_file")
  systemd-creds --name="$pass_name" decrypt "$pass_file" - | \
    chroot "$root_mnt" systemd-creds --quiet $key_arg --name="$pass_name" encrypt - "$pass_file"
  chmod 0400 "$root_mnt$pass_file"
  rm -f "$pass_file"
done
chroot "$root_mnt" /usr/local/sbin/restic-restore-finish

echo -e "${fg_green}\n\nALL DONE.\n\n\n" \
  "\b1. If there have been any errors in the restic restore process before due to" \
  "directory not being replaced by symlink, then those need to be resolved manually." \
  "The usual way to resolve those will be to check that those directories don't have" \
  "any custom changes, check which package it belongs to using 'dpkg -S <full path>'," \
  "reinstall the package using 'apt reinstall <package>'. If reinstall also causes" \
  "trouble with the directory, then delete the directory and reinstall again.\n\n" \
  "\b2. The systemd service timers for restic services namely restic-backup.timer" \
  "and restic-prune.timer have been disabled. Ensure that everything works fine" \
  "by logging into the restored system and then enable the two.\n\n" \
  "\b3. Ubuntu pro advantage was not enabled on the new system, so if it was not" \
  "enabled previously, then you may want to enable it using 'sudo pro attach ...'" \
  "after obtaining the required key from https://ubuntu.com/pro/dashboard.\n\n" \
  "\b4. You may also want to re-run 'sudo gen-local-checksums.sh' after login" \
  "since some of the checksums in /etc, /boot will have definitely changed after" \
  "the restore.\n\n$fg0"
